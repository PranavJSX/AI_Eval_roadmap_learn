
class ToxicityEvaluator():
    def __init__(self, threshold:False):
        self.threshold = threshold

    @property
    def threshold(self) -> float:
        return self._threshold

    @threshold.setter
    def threshold(self, value:float):
        if not isinstance(value, (int, float)):
            raise TypeError("Threshold must be numeric")
        if not (0.0 <= value <= 1.0):
            raise ValueError("Threshold must be between 0.0 and 1.0")

        self.threshold = float(value)


'''
🎯 Challenge: TemperatureSensor Guardrails
In an AI model monitoring dashboard, temperature drift can skew model outputs. You need to build a TemperatureSensor class that keeps track of a model's temperature setting.
'''
class TemperatureSensor():
    def __init__(self, temperature):
        self.temperature = temperature

    @property
    def temperature(self) -> float:
        return self._temperature

    @temperature.setter
    def temperature(self, value):
        if not isinstance(value, (float,int)):
            raise TypeError("Temperature must be a number!")
        if not (0.0<=value<=2.0):
            raise ValueError("Temperature must be between 0.0 and 2.0")

        self._temperature = value


class TemperatureConverter():
    def __init__(self, celcius):
        self.celcius = celcius

    @property
    def farenheit(self) -> float:
        return (self._celcius * 9 /5 ) + 32

    @property
    def celcius(self) -> float:
        return self._celcius

    @celcius.setter
    def celcius(self, value:float):
        if not isinstance(value, (int, float)):
            raise TypeError("Temperature must be numeric!")

        self.celcius = value